{
	"appId": "com.rodrigo.mycarwash.app",
	"appName": "My Carwash",
	"webDir": "dist",
	"server": {
		"url": "https://my-carwashapp-e6aba.web.app/",
		"cleartext": true,
		"allowNavigation": [
			"my-carwashapp-e6aba.web.app",
			"*.firebaseapp.com",
			"*.googleapis.com",
			"*.gstatic.com"
		]
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#0F172A",
			"showSpinner": true,
			"androidSpinnerStyle": "large",
			"spinnerColor": "#3B82F6"
		}
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true
	}
}
